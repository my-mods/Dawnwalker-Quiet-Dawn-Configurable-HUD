[
  {
    "type": "attribute",
    "key": "customFileName",
    "value": "Quiet Dawn - Configurable HUD"
  },
  {
    "type": "attribute",
    "key": "version",
    "value": "1.0.1"
  },
  {
    "type": "attribute",
    "key": "description",
    "value": "Quiet HUD with a 3-second player HUD peek on the Controls Legend hold gesture, and full-opacity health alerts below 50% or for 4 seconds after HP/blood loss. Stamina reveals below 20% or for 1.5 seconds after use. Enemy health bars hidden; directional indicators follow the menu setting."
  },
