<?xml version="1.0" encoding="utf-8"?>
<!-- mod.manifest -->
<mod>
  <info>
    <name>Quiet Dawn - Configurable HUD</name>
    <modid>QuietDawnHUD</modid>
    <description>Quiet, configurable HUD with Vanilla, Quiet Dawn, Fixed Opacity and Always Hidden modes for 17 player panels. Show HUD through Controls Legend hold or Focus mode, with individual panel inclusion choices. Enemy health bars, names, difficulty icons and combat cues remain separately configurable.</description>
    <author>my-mods</author>
    <version>1.2.2-dev</version>
    <created_on>2026-09-06</created_on>
  </info>
  <supports><game>The Blood of Dawnwalker</game><steam_build>25232147</steam_build><loader>Dawnwalker-compatible UE4SS with delayed game-thread callbacks</loader></supports>
</mod>
