**/SettingsStore.lua -text whitespace=cr-at-eol
**/UE4SSCommon*.lua -text whitespace=cr-at-eol
**/UE4SSDawnwalker*.lua -text whitespace=cr-at-eol
LICENSES/*-ue4ss-common.txt -text
